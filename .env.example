# Secret key for JWT tokens (generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))")
SECRET_KEY=your-secret-key-change-in-production

# Database URL (SQLite by default)
DATABASE_URL=sqlite:///./app.db

# Port for the application
PORT=8000

# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT token expiration in days
ACCESS_TOKEN_EXPIRE_DAYS=30

# Telegram integration (optional; bot token is configured only in bot service)
TELEGRAM_SERVICE_KEY=
TELEGRAM_BOT_USERNAME=
TELEGRAM_NOTIFICATION_TIMEZONE=Europe/Moscow
TELEGRAM_REMINDER_HOUR=10

# Optional personal-data policy overrides. Defaults: admin account contact,
# Republic of Belarus, role-limited member access, no fixed calendar retention.
# Operator identity/address omitted at the owner's request; fill for legal completeness.
PERSONAL_DATA_OPERATOR=
PERSONAL_DATA_ADDRESS=
PERSONAL_DATA_CONTACT=https://famcs-legacy.by/user/admin
PERSONAL_DATA_PROCESSORS=
PERSONAL_DATA_RETENTION=
